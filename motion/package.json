{
  "name": "motion-pessoal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Motion design pessoal, criado em código e renderizado em MP4. Sem aplicativo e sem APIs pagas.",
  "scripts": {
    "check": "tsc --noEmit",
