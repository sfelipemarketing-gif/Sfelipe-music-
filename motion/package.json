    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.2.8",
    "@remotion/bundler": "4.0.541",
    "@remotion/renderer": "4.0.541",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.541",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
